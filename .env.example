# Docker image tags
KUBO_IMAGE_TAG=latest
IPFS_CLUSTER_IMAGE_TAG=latest

# Shared IPFS Cluster secret (32 bytes hex / 64 chars)
CLUSTER_SECRET=3f4b7c0c8d5ef8f1e9c739a56bb14e2d72cdd7b2bce59adcd6f18f7a8f65de11

# Replication policy
CLUSTER_REPLICATION_MIN=2
CLUSTER_REPLICATION_MAX=3

# Published host ports (node 0 / cluster 0 only)
IPFS0_API_PORT=5001
IPFS0_GATEWAY_PORT=8080
IPFS0_SWARM_PORT=4001
CLUSTER_API_PORT=9094
CLUSTER_PROXY_PORT=9095
